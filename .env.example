# Copia este archivo como .env y rellena los valores reales

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/<base_de_datos>?appName=<AppName>

# Puerto del servidor (opcional, default 3000)
PORT=3000

# Secreto para firmar JWT — usa una cadena larga y aleatoria (mínimo 32 caracteres)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# Token del bot de Telegram
TELEGRAM_BOT_TOKEN=<token_del_bot>
